            "url": "{{empresas_api}}/empresas",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruc\": \"20601234567\",\n  \"razon_social\": \"Suministros Andinos S.A.C.\",\n  \"email\": \"compras@suministrosandinos.pe\",\n  \"rubros\": [\n    \"Útiles de oficina\",\n    \"Limpieza e higiene\",\n    \"Mobiliario\"\n  ],\n  \"capitulos_rnp\": [\n    \"Bienes\",\n    \"Servicios\"\n  ],\n  \"experiencia_facturada\": 850000,\n  \"regiones\": [\n    \"Lima\",\n    \"Callao\",\n    \"Ica\"\n  ],\n  \"personal_clave\": \"1 jefe de logística, 6 operarios de almacén, 2 choferes con licencia A-IIb\",\n  \"certificaciones\": \"ISO 9001:2015 (gestión de la calidad)\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
