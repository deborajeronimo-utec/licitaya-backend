                "value": "application/json"
              }
            ],
            "url": "{{workflow_api}}/lotes",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruc\": \"{{ruc}}\",\n  \"archivos\": [\n    \"conv-01-papel-bond-ugel.md\",\n    \"conv-02-limpieza-hospital.md\",\n    \"conv-03-mobiliario-municipal.md\",\n    \"conv-04-computo-universidad.md\",\n    \"conv-05-uniformes-arequipa.md\",\n    \"conv-06-mantenimiento-colegios.md\",\n    \"conv-07-obra-pista.md\",\n    \"conv-08-toner-lima-norte.md\",\n    \"conv-09-vigilancia-junin.md\",\n    \"conv-10-alimentos-callao.md\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"lote_id\", r.lote_id);",
                  "pm.collectionVariables.set(\"upload_url_0\", r.archivos[0].upload_url);",
                  "pm.test(\"10 URLs prefirmadas\", () => pm.expect(r.archivos.length).to.eql(10));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Subir conv-01 con URL prefirmada (200)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/markdown"
              }
            ],
            "url": "{{upload_url_0}}",
            "description": "Ejemplo de carga de un archivo. Para cargar las 10 convocatorias use scripts/cargar_convocatorias.py o la web.",
            "body": {
              "mode": "raw",
              "raw": "> **Convocatoria FICTICIA para pruebas de LicitaYa.** No corresponde a un proceso real del SEACE.\n\n# Resumen de bases – Adquisición de papel bond A4 de 75 g y útiles de escritorio para las instituciones educativas de la jurisdicción\n\n| Campo | Detalle |\n|---|---|\n| Entidad convocante | UGEL N.° 05 – San Juan de Lurigancho |\n| Objeto de la contratación | Adquisición de papel bond A4 de 75 g y útiles de escritorio para las instituciones educativas de la jurisdicción |\n| Tipo de procedimiento | Procedimiento de selección (Ley N.° 32069) |\n| Capítulo RNP requerido | Bienes |\n| Valor estimado | S/ 148,500 |\n| Fecha límite de presentación de ofertas | 2026-11-27 |\n| Lugar de entrega / ejecución | Lima Metropolitana (almacén central de la UGEL, San Juan de Lurigancho) |\n\n## Requisitos de calificación\n- Inscripción vigente en el RNP, capítulo de Bienes.\n- Experiencia mínima facturada en venta de útiles de oficina o papelería: S/ 300,000 en los últimos 8 años.\n- Plazo de entrega: 15 días calendario desde la firma del contrato.\n- Ficha técnica del papel (gramaje, blancura, opacidad).\n\n## Factores de evaluación\n- Precio: 80 puntos.\n- Plazo de entrega o ejecución: 10 puntos.\n- Certificaciones de calidad: 10 puntos.\n\n## Observaciones\nEntrega en una sola armada. Se valorará la certificación ISO 9001.\n"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
